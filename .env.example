# Copy to .env and fill in. Never commit .env. Keep comments on their own lines.

# ---- MCP server (local defaults need nothing from AWS) ----
# memory | dynamodb
STORE=memory
# local | s3
PHOTOS=local
# memory store only: load the demo household (Mochi, Jeremy) at startup
SEED_ON_START=true
HOUSEHOLD_ID=demo
HOUSEHOLD_TZ=America/Los_Angeles
# Shared by server and simulator. Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# Browser origins allowed to call /mcp (the simulator page). Comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Where a phone reaches this server for photo uploads. Leave empty to use each request's own host.
# Local demo with a real phone: your laptop's LAN address, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=
# When STORE=dynamodb / PHOTOS=s3 (from the stack outputs):
# TABLE_NAME=
# PHOTO_BUCKET=

# ---- Simulator (the web page that plays Alexa+) ----
# Local server, or the McpUrl stack output after deploying
MCP_URL=http://127.0.0.1:8000/mcp
# A Bedrock model or inference profile id you have access to, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Leave empty for offline mode (a few fixed demo phrases, no AWS needed).
BEDROCK_MODEL_ID=

# ---- Deploy (AWS credentials come from `aws configure`, never from this file) ----
AWS_REGION=us-east-1
BUDGET_EMAIL=you@example.com
STACK_NAME=cat-nanny
