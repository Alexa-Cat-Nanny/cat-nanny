# Copy to .env and fill in. Never commit .env. Keep comments on their own lines.

# ---- MCP server (local defaults need nothing from AWS) ----
# memory | dynamodb
STORE=memory
# memory store only: load Mochi's sample history at startup
SEED_ON_START=true
HOUSEHOLD_ID=demo
HOUSEHOLD_TZ=America/Los_Angeles
# log | sns
NOTIFIER=log
# Shared by server and simulator. Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# From the stack outputs, when STORE=dynamodb / NOTIFIER=sns:
# TABLE_NAME=
# SNS_TOPIC_ARN=

# ---- Simulator (the web page that plays Alexa+) ----
# Local server, or the McpUrl stack output after deploying
MCP_URL=http://localhost:8000/mcp
# A Bedrock model or inference profile id you have access to (Bedrock console > Model catalog).
# Leave empty for offline mode (a few fixed demo phrases).
BEDROCK_MODEL_ID=

# ---- Deploy ----
AWS_REGION=us-east-1
ALERT_EMAIL=you@example.com
STACK_NAME=cat-nanny
